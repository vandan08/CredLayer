# Backend risk-engine API (Spring Boot). No trailing slash.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Chain selection: leave unset for local Hardhat, or "sepolia" for testnet.
# NEXT_PUBLIC_CHAIN=sepolia

# Optional custom RPC (Alchemy/Infura). Falls back to a public RPC when unset.
# NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Canonical public URL. Used for Open Graph / Twitter card metadata so the
# link renders a preview card when shared. Set this on Vercel to your real
# domain, e.g. https://credlayer.vercel.app
# NEXT_PUBLIC_SITE_URL=https://credlayer.vercel.app
